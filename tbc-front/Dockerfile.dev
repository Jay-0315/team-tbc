# Vite + React 개발 서버 (개발용)
FROM node:20

WORKDIR /app

# 의존성 파일 복사 및 설치 (캐시 최적화)
COPY package.json package-lock.json* ./
RUN npm ci --only=production=false && \
    npm cache clean --force

# 포트 노출
EXPOSE 5173

# 개발 서버 실행 (볼륨 마운트로 소스 코드 변경 시 즉시 반영)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]